# Keep source and documentation normalized in the repository.
* text=auto eol=lf

# ESP-IDF and C/C++ sources
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Firmware and media assets are binary.
*.bin binary
*.elf binary
*.map binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ogg binary
*.wav binary
*.zip binary
