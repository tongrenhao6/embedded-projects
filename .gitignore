# ============================================
# Embedded Projects Repo .gitignore
# ============================================

# ---- Keil MDK / ARMCC build artifacts ----
Objects/
Listings/
*.o
*.crf
*.d
*.axf
*.hex
*.bin
*.map
*.lnp
*.htm
*.lst
*.bak
*.dep
*.plg
*.scr
*.scr.htm
*.uvguix.*
*.uvgui.*
JLinkLog.txt
JLinkSettings.ini
DebugConfig/
RTE/_*/
RTE/.*
*.dbgconf

# ---- STM32CubeIDE / Eclipse ----
.metadata/
*.launch
.settings/

# ---- ESP-IDF build (for ESP32 projects) ----
build/
build-gec/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
.idf_tools/

# ---- gaga-desk-pet specific ----
gaga-desk-pet/xiaozhi-v2.3.0.zip
gaga-desk-pet/tmp/

# ---- Python (scripts / report generation) ----
__pycache__/
*.pyc
*.pyo

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Documents / large binaries ----
*.docx
*.pdf

# ---- Editor ----
.vscode/
.idea/
*.user
*.suo

# ---- Git worktrees ----
.worktrees/
