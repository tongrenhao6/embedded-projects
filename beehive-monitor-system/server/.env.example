# Copy this file as .env beside BeehiveMonitor.exe, then set BEEHIVE_DB_PASSWORD.
# For manual PowerShell startup, load the same values into that session instead.
BEEHIVE_SERIAL_PORT=COM7
BEEHIVE_SERIAL_BAUD=115200
BEEHIVE_DB_HOST=127.0.0.1
BEEHIVE_DB_PORT=3306
BEEHIVE_DB_NAME=beehive_gateway
BEEHIVE_DB_USER=beehive_app
BEEHIVE_DB_PASSWORD=replace-with-your-password
BEEHIVE_MQTT_URI=mqtt://broker.emqx.io:1883
BEEHIVE_MQTT_USERNAME=
BEEHIVE_MQTT_PASSWORD=
BEEHIVE_MQTT_CLIENT_ID=beehive_web
BEEHIVE_MQTT_TOPIC_PREFIX=beehive/v1
# Set BEEHIVE_MQTT_TOPIC_MODE=bemfa for Bemfa Cloud flat custom topics.
BEEHIVE_MQTT_TOPIC_MODE=hierarchical
BEEHIVE_MQTT_TELEMETRY_TOPIC=
BEEHIVE_MQTT_STATUS_TOPIC=
BEEHIVE_MQTT_GATEWAY_ID=gw-001
BEEHIVE_MQTT_FLAT_NODE_ID=1
BEEHIVE_MQTT_KEEPALIVE=30
BEEHIVE_MQTT_RECONNECT_DELAY=3
BEEHIVE_HTTP_HOST=127.0.0.1
BEEHIVE_HTTP_PORT=8000
